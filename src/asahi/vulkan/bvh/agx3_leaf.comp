/* Copyright 2026 Aurora Silicon
 * SPDX-License-Identifier: MIT
 *
 * Native M5 Gen3 nodes, derived from the saved 2/4/8/64-triangle AGX
 * captures and agx_rt_blas_gen3.h. Eight lanes encode one independent node,
 * and a workgroup, one 32-lane subgroup, encodes HK_AGX3_NODE_JOBS_PER_GROUP
 * of them: one lane per child for its bounds, its root word, its record and
 * its QTB vertex bytes. The eight lanes of a node share its bounds, each QTB
 * block's bounds and their checks through clustered subgroup operations, so
 * encoding needs no shared memory or barriers. Inner nodes read child bounds
 * from the same common build IR. No CPU readback, cross-workgroup
 * synchronization, or global allocator.
 *
 * Built with HK_AGX3_REFIT for updates: jobs come from the retained jobs
 * (see hk_agx3_retained_job). Each leaf job encodes as above and leaves its
 * bounds for its parent, or NaN bounds when it fails, so that its
 * ancestors fail too; agx3_refit.comp then encodes the inner jobs. After a
 * triangle update's leaf pass (agx3_refit_leaf.comp), leaf jobs read their
 * children at their slots instead of from IR leaves.
 */
#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float32 : require

#include "hk_build_interface.h"
#include "agx3_node.h"

/* Variants for one geometry kind: their jobs are inner nodes or that
 * kind's leaves only, so the other kinds' encoders, and their registers,
 * drop out. A job of another kind fails as an invalid job. */
#ifdef HK_AGX3_REFIT_TRIANGLES
#define HK_AGX3_REFIT 1
#define HK_AGX3_LEAF_ONLY HK_AGX3_NODE_LEAF
#endif
/* Only triangle structures pair triangles. */
#if defined(HK_AGX3_LEAF_PAIRS) && !defined(HK_AGX3_LEAF_ONLY)
#define HK_AGX3_LEAF_ONLY HK_AGX3_NODE_LEAF
#endif

#define JOBS HK_AGX3_NODE_JOBS_PER_GROUP
/* Built twice: HK_AGX3_LEAF_PAIRS encodes jobs whose children may be
 * triangle pairs (see hk_agx3_plan_args.pairs) and keeps four vertices per
 * child; the other build serves every other job with three. */
#ifdef HK_AGX3_LEAF_PAIRS
#define VERTICES 4u
#else
#define VERTICES 3u
#endif
layout(local_size_x = 8 * JOBS) in;
layout(push_constant) uniform CONSTS
{
#ifdef HK_AGX3_REFIT
   hk_agx3_refit_encode_args args;
#else
   hk_agx3_leaf_args args;
#endif
};

#include "agx3_leaf_body.h"
