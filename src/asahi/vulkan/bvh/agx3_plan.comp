/* Copyright 2026 Aurora Silicon
 * SPDX-License-Identifier: MIT
 *
 * Convert a common binary BVH into independent native-node encoding jobs.
 * Collapse up to three binary levels into each wide inner node; stop early
 * at subtrees containing at most eight triangle records. Those subtrees
 * become one leaf cluster. A record holds one triangle, or two sibling
 * triangles that share an edge (phase 0 marks their parent as a pair).
 * Preserve the common builder's spatial partition and order. Built twice:
 * HK_AGX3_PLAN_PAIRS forms pairs (see hk_agx3_plan_args.pairs).
 * A global atomic allocator compacts jobs/child regions; it never changes
 * traversal order. The five phases are separated by dispatch barriers.
 * An update does not plan: it encodes from the retained jobs (see
 * hk_agx3_retained_job).
 */
#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float32 : require
#include "hk_build_interface.h"

layout(local_size_x = 64) in;
layout(push_constant) uniform CONSTS
{
   hk_agx3_plan_args args;
};

/* The common builder's internal node count, final before planning starts:
 * main() reads it once rather than every source_index() reloading it past
 * this invocation's own stores and atomics. */
uint internal_count;

void
fail(uint flag)
{
   atomicOr(DEREF(args.state).error, flag);
}


uint
leaf_size()
{
   return args.geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR
             ? SIZEOF(vk_ir_instance_node)
             : args.geometry_type == VK_GEOMETRY_TYPE_AABBS_KHR
                ? SIZEOF(vk_ir_aabb_node) : SIZEOF(vk_ir_triangle_node);
}

uint
source_index(uint ir_id)
{
   if (ir_id == VK_BVH_INVALID_NODE)
      return 0xffffffffu;
   uint offset = ir_id_to_offset(ir_id), kind = ir_id_to_type(ir_id);
   if (kind == (args.geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR ? vk_ir_node_instance : args.geometry_type == VK_GEOMETRY_TYPE_AABBS_KHR ? vk_ir_node_aabb : vk_ir_node_triangle) && offset < args.root_offset &&
       offset % leaf_size() == 0) {
      uint i = offset / leaf_size();
      if (i < args.leaf_bound)
         return i;
   }
   if (kind == vk_ir_node_internal && offset >= args.root_offset &&
       (offset - args.root_offset) % SIZEOF(vk_ir_box_node) == 0) {
      uint i = (offset - args.root_offset) / SIZEOF(vk_ir_box_node);
      if (i < internal_count &&
          i < args.node_bound - args.leaf_bound)
         return args.leaf_bound + i;
   }
   fail(HK_AGX3_PLAN_INDEX);
   return 0xffffffffu;
}

uint
source_offset(uint index)
{
   return index < args.leaf_bound
             ? index * leaf_size()
             : args.root_offset +
                  (index - args.leaf_bound) * SIZEOF(vk_ir_box_node);
}

uint
root_index()
{
   return args.leaf_bound + internal_count - 1;
}

uvec2
children(uint index)
{
   REF(vk_ir_box_node)
   node =
      REF(vk_ir_box_node)(OFFSET(args.intermediate_bvh, source_offset(index)));
   return uvec2(DEREF(node).children[0], DEREF(node).children[1]);
}

#ifdef HK_AGX3_PLAN_PAIRS
/* Triangle leaf index of an IR child reference, or ~0u. Unlike
 * source_index() this never records an error, so phase 0 may use it before
 * the plan state exists. */
uint
triangle_index(uint ir_id)
{
   if (ir_id == VK_BVH_INVALID_NODE || ir_id_to_type(ir_id) != vk_ir_node_triangle)
      return ~0u;
   uint offset = ir_id_to_offset(ir_id);
   if (offset >= args.root_offset || offset % SIZEOF(vk_ir_triangle_node) != 0)
      return ~0u;
   uint i = offset / SIZEOF(vk_ir_triangle_node);
   return i < args.leaf_bound ? i : ~0u;
}

/* Pair flags (HK_AGX3_PLAN_PAIR...) for internal node `index`: set when its
 * children are two triangles of one geometry and opacity sharing an edge,
 * which then make up one native record. */
uint
pair_flags(uint index)
{
   if (index < args.leaf_bound ||
       index - args.leaf_bound >= internal_count)
      return 0u;
   uvec2 pair = children(index);
   uint t0 = triangle_index(pair[0]), t1 = triangle_index(pair[1]);
   if (t0 == ~0u || t1 == ~0u)
      return 0u;
   REF(vk_ir_triangle_node) a = REF(vk_ir_triangle_node)(
      OFFSET(args.intermediate_bvh, source_offset(t0)));
   REF(vk_ir_triangle_node) b = REF(vk_ir_triangle_node)(
      OFFSET(args.intermediate_bvh, source_offset(t1)));
   uint flags = DEREF(a).geometry_id_and_flags;
   if (flags != DEREF(b).geometry_id_and_flags)
      return 0u;
   vec3 va[3], vb[3];
   for (uint v = 0; v < 3; ++v)
      for (uint c = 0; c < 3; ++c) {
         va[v][c] = DEREF(a).coords[v][c];
         vb[v][c] = DEREF(b).coords[v][c];
      }
   if (hk_agx3_shared_edge(va, vb) == ~0u)
      return 0u;
   return HK_AGX3_PLAN_PAIR |
          ((flags & VK_GEOMETRY_OPAQUE) != 0 ? HK_AGX3_PLAN_PAIR_OPAQUE : 0u);
}

bool
is_pair(uint index)
{
   return index >= args.leaf_bound &&
          (DEREF(INDEX(hk_agx3_plan_node, args.nodes, index)).depth &
           HK_AGX3_PLAN_PAIR) != 0u;
}
#endif

/* Every non-empty pending subtree contributes at least one leaf. Stop at
 * nine before pushing past this bounded stack, even for a skewed tree. A
 * triangle pair counts as one leaf. */
uint
count_leaves(uint start)
{
   uint stack[9], sp = 1, count = 0, steps = 0;
   uint opacity = 0;
   bool have_opacity = false;
   stack[0] = start;
   while (sp != 0) {
      if (++steps > args.node_bound * 2u) {
         fail(HK_AGX3_PLAN_CYCLE);
         return 0;
      }
      uint index = stack[--sp];
#ifdef HK_AGX3_PLAN_PAIRS
      uint flags = index < args.leaf_bound ? 0u
         : DEREF(INDEX(hk_agx3_plan_node, args.nodes, index)).depth;
      if (index < args.leaf_bound || (flags & HK_AGX3_PLAN_PAIR) != 0u) {
         if (args.geometry_type == VK_GEOMETRY_TYPE_TRIANGLES_KHR) {
            uint current_opacity;
            if (index < args.leaf_bound) {
               REF(vk_ir_triangle_node) triangle = REF(vk_ir_triangle_node)(
                  OFFSET(args.intermediate_bvh, source_offset(index)));
               current_opacity = DEREF(triangle).geometry_id_and_flags &
                                 VK_GEOMETRY_OPAQUE;
            } else {
               current_opacity = (flags & HK_AGX3_PLAN_PAIR_OPAQUE) != 0u
                                    ? VK_GEOMETRY_OPAQUE : 0u;
            }
#else
      if (index < args.leaf_bound) {
         if (args.geometry_type == VK_GEOMETRY_TYPE_TRIANGLES_KHR) {
            REF(vk_ir_triangle_node) triangle = REF(vk_ir_triangle_node)(
               OFFSET(args.intermediate_bvh, source_offset(index)));
            uint current_opacity = DEREF(triangle).geometry_id_and_flags &
                                   VK_GEOMETRY_OPAQUE;
#endif
            /* One native leaf cluster shares its child triangle type.
             * A mixed-opacity subtree must remain an inner node; retain
             * normal spatial collapse for every homogeneous subtree. */
            if (have_opacity && opacity != current_opacity)
               return 9;
            opacity = current_opacity;
            have_opacity = true;
         }
         ++count;
      } else {
         uvec2 pair = children(index);
         for (uint c = 0; c < 2; c++)
            if (pair[c] != VK_BVH_INVALID_NODE) {
               uint child = source_index(pair[c]);
               if (child == 0xffffffffu)
                  return 0;
               if (sp == 9)
                  return 9;
               stack[sp++] = child;
            }
      }
      if (count + sp > 8)
         return 9;
   }
   return count;
}

/* Surface area of an IR node's bounds, the open order of wide_children(). */
float
node_area(uint index)
{
   REF(vk_ir_node)
   node = REF(vk_ir_node)(OFFSET(args.intermediate_bvh, source_offset(index)));
   vec3 extent = max(DEREF(node).aabb.max - DEREF(node).aabb.min, vec3(0.0));
   return extent.x * extent.y + extent.y * extent.z + extent.z * extent.x;
}

/* Whether a wide inner node may open binary node `index` into its two
 * children: an internal node that is neither a leaf cluster nor a pair. */
bool
openable(uint index)
{
   return index >= args.leaf_bound &&
          DEREF(INDEX(hk_agx3_plan_node, args.nodes, index)).leaf_count > 8;
}

/* With args.wide_children, the children of the wide inner node over binary
 * node `root`. Start from its binary children, then open the openable child
 * of largest surface area while the node has room for one more. The child
 * that a ray is most likely to enter goes one level further down, rather
 * than every child down a fixed three levels, so nodes fill up and
 * low-probability subtrees stay shallow. Opening replaces the child by its
 * own children in place, so the binary tree's left-to-right order holds.
 * Returns the child count, 0 on a malformed tree. */
uint
wide_children(uint root, out uint list[8])
{
   uint count = 0;
   uvec2 pair = children(root);
   for (uint c = 0; c < 2; c++)
      if (pair[c] != VK_BVH_INVALID_NODE) {
         uint child = source_index(pair[c]);
         if (child == 0xffffffffu)
            return 0;
         list[count++] = child;
      }
   for (uint steps = 0; steps < 64u && count < 8u; steps++) {
      uint best = 8u;
      float best_area = -1.0;
      for (uint c = 0; c < count; c++)
         if (openable(list[c])) {
            float area = node_area(list[c]);
            if (area > best_area) {
               best = c;
               best_area = area;
            }
         }
      if (best == 8u)
         break;
      pair = children(list[best]);
      uint first = source_index(pair[0]), second = source_index(pair[1]);
      if (pair[0] == VK_BVH_INVALID_NODE || pair[1] == VK_BVH_INVALID_NODE) {
         /* One child: open in place. */
         uint only = pair[0] != VK_BVH_INVALID_NODE ? first : second;
         if (only == 0xffffffffu)
            return 0;
         list[best] = only;
         continue;
      }
      if (first == 0xffffffffu || second == 0xffffffffu)
         return 0;
      for (uint c = count; c > best + 1u; c--)
         list[c] = list[c - 1u];
      list[best] = first;
      list[best + 1u] = second;
      count++;
   }
   return count;
}

/* Binary ancestors of one node by depth, a window at a time. */
uint path_window[32];
uint path_base;

uint
ancestor_at(uint id, uint id_depth, uint depth)
{
   if (depth < path_base || depth >= path_base + 32u) {
      path_base = depth;
      uint cursor = id;
      for (uint d = id_depth; d >= depth; d--) {
         if (d < depth + 32u)
            path_window[d - depth] = cursor;
         if (d == 0u)
            break;
         cursor = DEREF(INDEX(hk_agx3_plan_node, args.nodes, cursor)).parent;
      }
   }
   return path_window[depth - path_base];
}

/* With args.wide_children: the wide level of the native node over binary
 * node `id` at binary depth `id_depth`, or ~0u if `id` gets no native node
 * (a wide node above opened it). Replays wide_children() from the root down
 * the path to `id`, as emit() will. */
uint
wide_level(uint id, uint id_depth, uint root)
{
   uint node = root, depth = 0, level = 0;
   path_base = 0xffffffffu;
   for (uint guard = 0; guard <= id_depth; guard++) {
      if (node == id)
         return level;
      uint list[8];
      uint count = wide_children(node, list);
      if (count == 0u)
         return ~0u;
      uint next = ~0u;
      for (uint d = depth + 1u; d <= id_depth && next == ~0u; d++) {
         uint step = ancestor_at(id, id_depth, d);
         for (uint c = 0; c < count; c++)
            if (list[c] == step) {
               next = step;
               depth = d;
            }
      }
      if (next == ~0u)
         return ~0u;
      node = next;
      level++;
   }
   fail(HK_AGX3_PLAN_CYCLE);
   return ~0u;
}

void
initialize(uint id)
{
   if (id < args.node_bound) {
      hk_agx3_plan_node node;
      node.parent = 0xffffffffu;
      node.leaf_count = id < args.leaf_bound ? 1u : 0u;
#ifdef HK_AGX3_PLAN_PAIRS
      node.depth = pair_flags(id);
      node.job = 0xffffffffu;
      if (node.depth != 0u)
         node.leaf_count = 1;
#else
      node.depth = 0;
      node.job = 0xffffffffu;
#endif
      DEREF(INDEX(hk_agx3_plan_node, args.nodes, id)) = node;
   }
   if (id == 0) {
      hk_agx3_plan_state state;
      state.job_count = 0;
      state.groups_y = 1;
      state.groups_z = 1;
      state.next_slot = 3;
      state.depth = 0;
      state.error = 0;
      state.saved_offsets = 0;
      state.saved_positions = 0;
      if (DEREF(args.header).active_leaf_count == 0)
         state.error = HK_AGX3_PLAN_EMPTY;
      if (args.leaf_bound > args.node_bound || args.node_bound > 0xffffffffu / 64u ||
          (DEREF(args.header).active_leaf_count != 0 &&
           (DEREF(args.header).ir_internal_node_count == 0 ||
            DEREF(args.header).ir_internal_node_count >
               args.node_bound - args.leaf_bound)) ||
          DEREF(args.header).active_leaf_count > args.leaf_bound ||
          args.root_offset != args.leaf_bound * leaf_size() ||
          args.output_bvh == 0 || (args.output_bvh & 63ul) != 0 ||
          args.output_bvh >= (1ul << 48) ||
          uint64_t(args.slot_bound) * 64ul + 184ul > (1ul << 48) - args.output_bvh ||
          args.slot_bound < 5)
         state.error |= HK_AGX3_PLAN_INDEX;
      DEREF(args.state) = state;
   }
}

void
link_and_count(uint id)
{
   if (id < args.leaf_bound ||
       id >= args.leaf_bound + internal_count)
      return;
   uvec2 pair = children(id);
   for (uint c = 0; c < 2; c++)
      if (pair[c] != VK_BVH_INVALID_NODE) {
         uint child = source_index(pair[c]);
         if (child == 0xffffffffu)
            return;
         uint old = atomicCompSwap(
            DEREF(INDEX(hk_agx3_plan_node, args.nodes, child)).parent,
            0xffffffffu, id);
         if (old != 0xffffffffu)
            fail(HK_AGX3_PLAN_SHAPE);
      }
#ifdef HK_AGX3_PLAN_PAIRS
   if (!is_pair(id))
#endif
      DEREF(INDEX(hk_agx3_plan_node, args.nodes, id)).leaf_count =
         count_leaves(id);
}

void
classify(uint id)
{
   if (id >= args.node_bound)
      return;
   hk_agx3_plan_node node = DEREF(INDEX(hk_agx3_plan_node, args.nodes, id));
   uint root = root_index();
   if (id != root && node.parent == 0xffffffffu)
      return; /* inactive IR leaf */
   uint cursor = id, depth = 0;
   while (cursor != root) {
      if (depth++ >= args.node_bound) {
         fail(HK_AGX3_PLAN_CYCLE);
         return;
      }
      cursor = DEREF(INDEX(hk_agx3_plan_node, args.nodes, cursor)).parent;
      if (cursor >= args.node_bound) {
         fail(HK_AGX3_PLAN_INDEX);
         return;
      }
   }
#ifdef HK_AGX3_PLAN_PAIRS
   DEREF(INDEX(hk_agx3_plan_node, args.nodes, id)).depth =
      depth | (node.depth & (HK_AGX3_PLAN_PAIR | HK_AGX3_PLAN_PAIR_OPAQUE));
#else
   DEREF(INDEX(hk_agx3_plan_node, args.nodes, id)).depth = depth;
#endif
   bool selected = id == root;
   if (!selected)
      selected = node.leaf_count <= 8
                    ? DEREF(INDEX(hk_agx3_plan_node, args.nodes, node.parent))
                            .leaf_count > 8
                    : args.wide_children != 0u || depth % 3 == 0;
   if (!selected)
      return;
   /* Native levels below and including this node's. */
   uint levels = (depth + 2u) / 3u + 1u;
   if (args.wide_children != 0u) {
      uint level = wide_level(id, depth, root);
      if (level == ~0u) {
         /* A leaf cluster always has a wide parent; an opened node has none. */
         if (node.leaf_count <= 8)
            fail(HK_AGX3_PLAN_SHAPE);
         return;
      }
      levels = level + 1u;
   }
   uint job = atomicAdd(DEREF(args.state).job_count, 1);
   if (job >= args.node_bound) {
      fail(HK_AGX3_PLAN_ALLOCATION);
      return;
   }
   DEREF(INDEX(hk_agx3_plan_node, args.nodes, id)).job = job;
   hk_agx3_leaf_job output_job;
   output_job.intermediate_bvh = args.intermediate_bvh;
   output_job.output_bvh = args.output_bvh;
   output_job.root_slot = id == root ? 0u : 0xffffffffu;
   output_job.child_slot = 0;
   output_job.child_count = 0;
   output_job.node_kind =
      node.leaf_count <= 8
         ? (args.geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR
               ? HK_AGX3_NODE_INSTANCES
               : args.geometry_type == VK_GEOMETRY_TYPE_AABBS_KHR
                  ? HK_AGX3_NODE_AABBS : HK_AGX3_NODE_LEAF)
         : HK_AGX3_NODE_INNER;
   for (uint i = 0; i < 8; i++)
      output_job.triangle_offsets[i] = 0;
   DEREF(INDEX(hk_agx3_leaf_job, args.jobs, job)) = output_job;
   atomicMax(DEREF(args.state).depth, levels);
}

void
emit(uint id)
{
   if (id >= args.node_bound)
      return;
   hk_agx3_plan_node node = DEREF(INDEX(hk_agx3_plan_node, args.nodes, id));
   if (node.job == 0xffffffffu)
      return;
   bool leaf = node.leaf_count <= 8;
   uint stack[9], level[9], selected[8], sp = 1, count = 0, steps = 0;
   stack[0] = id;
   level[0] = 0;
   if (!leaf && args.wide_children != 0u) {
      count = wide_children(id, selected);
      if (count == 0u) {
         fail(HK_AGX3_PLAN_SHAPE);
         return;
      }
      sp = 0;
   }
   while (sp != 0) {
      if (++steps > args.node_bound * 2u) {
         fail(HK_AGX3_PLAN_CYCLE);
         return;
      }
      uint current = stack[--sp], d = level[sp];
#ifdef HK_AGX3_PLAN_PAIRS
      bool end = leaf ? current < args.leaf_bound || is_pair(current)
                      : current != id &&
#else
      bool end = leaf ? current < args.leaf_bound
                      : current != id &&
#endif
                           (DEREF(INDEX(hk_agx3_plan_node, args.nodes, current))
                                  .leaf_count <= 8 ||
                            d == 3);
      if (end) {
         if (count == 8) {
            fail(HK_AGX3_PLAN_SHAPE);
            return;
         }
         selected[count++] = current;
      } else {
         uvec2 pair = children(current);
         /* Stack is LIFO; visit the common builder's left child first. */
         for (int c = 1; c >= 0; c--)
            if (pair[c] != VK_BVH_INVALID_NODE) {
               uint child = source_index(pair[c]);
               if (child == 0xffffffffu || sp == 9) {
                  fail(HK_AGX3_PLAN_SHAPE);
                  return;
               }
               stack[sp] = child;
               level[sp++] = d + 1;
            }
      }
   }
   if (count == 0 || (leaf && count != node.leaf_count)) {
      fail(HK_AGX3_PLAN_SHAPE);
      return;
   }
   uint slots = leaf ? (args.geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR
                           ? 2u * count
                           : args.geometry_type == VK_GEOMETRY_TYPE_AABBS_KHR
                              ? count : count + (count + 3u) / 4u) : count;
   uint first = atomicAdd(DEREF(args.state).next_slot, slots);
   if (slots > args.slot_bound || first > args.slot_bound - slots) {
      fail(HK_AGX3_PLAN_ALLOCATION);
      return;
   }
   REF(hk_agx3_leaf_job) job = INDEX(hk_agx3_leaf_job, args.jobs, node.job);
   DEREF(job).child_slot = first;
   DEREF(job).child_count = count;
   for (uint c = 0; c < count; c++) {
#ifdef HK_AGX3_PLAN_PAIRS
      DEREF(job).triangle_offsets[c] =
         source_offset(selected[c]) |
         (leaf && selected[c] >= args.leaf_bound ? HK_AGX3_LEAF_PAIR_OFFSET : 0u);
#else
      DEREF(job).triangle_offsets[c] = source_offset(selected[c]);
#endif
      if (!leaf) {
         uint child_job =
            DEREF(INDEX(hk_agx3_plan_node, args.nodes, selected[c])).job;
         if (child_job >= DEREF(args.state).job_count) {
            fail(HK_AGX3_PLAN_SHAPE);
            return;
         }
         DEREF(INDEX(hk_agx3_leaf_job, args.jobs, child_job)).root_slot =
            first + c;
      }
   }
}

void
finish(uint id)
{
   if (id != 0)
      return;
   hk_agx3_envelope_job job;
   uint root = DEREF(args.state).error == 0 ? root_index() : 0;
   job.bounds =
      REF(vk_ir_node)(OFFSET(args.intermediate_bvh, source_offset(root)));
   job.output_bvh = args.output_bvh;
   job.end_slot = DEREF(args.state).next_slot;
   job.primitive_count =
      DEREF(args.state).error == 0 ? DEREF(args.header).active_leaf_count : 0;
   job.node_count = DEREF(args.state).job_count;
   job.depth = DEREF(args.state).depth;
   job.opaque_build_word = DEREF(args.state).error == HK_AGX3_PLAN_EMPTY
                             ? HK_AGX3_PLAN_EMPTY : 0;
   job.resource_id = args.resource_id;
   job.geometry_type = args.geometry_type;
   job.leaf_bound = args.leaf_bound;
   DEREF(args.envelope) = job;
   uint jobs = DEREF(args.state).error != 0 ? 0u : DEREF(args.state).job_count;
   if (DEREF(args.state).error != 0)
      DEREF(args.state).job_count = 0;
   uint64_t dispatch = uint64_t(args.state) + uint64_t(HK_AGX3_PLAN_ENCODE_DISPATCH);
   DEREF(REF(uint32_t)(dispatch)) =
      (jobs + HK_AGX3_NODE_JOBS_PER_GROUP - 1u) / HK_AGX3_NODE_JOBS_PER_GROUP;
   DEREF(REF(uint32_t)(dispatch + 4ul)) = 1u;
   DEREF(REF(uint32_t)(dispatch + 8ul)) = 1u;
}

void
main()
{
   uint id = gl_GlobalInvocationID.x;
   internal_count = DEREF(args.header).ir_internal_node_count;
   if (args.phase == 0) {
      initialize(id);
      return;
   }
   if (args.phase == 4) {
      finish(id);
      return;
   }
   if (DEREF(args.state).error != 0)
      return;
   if (args.phase == 1)
      link_and_count(id);
   if (args.phase == 2)
      classify(id);
   if (args.phase == 3)
      emit(id);
}
