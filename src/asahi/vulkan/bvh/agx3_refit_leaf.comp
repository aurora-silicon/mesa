 *
 * An update's leaf pass for triangles, in place of generating IR leaves: a
 * thread per primitive of one geometry reads its triangle as leaf
 * generation does and leaves it at its leaf's slot (see
 * hk_agx3_retained_state), so that refit encoding reads each leaf job's
 * children together rather than gathering IR leaves. Reads follow the
 * application's index order; only the stores scatter.
 */
#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float32 : require
#include "hk_build_interface.h"
#include "agx3_node.h"

/* Inactive triangles have NaN vertices, as for leaf generation. */
#define SpvCapabilitySignedZeroInfNanPreserve 4466
#define SpvExecutionModeSignedZeroInfNanPreserve 4461
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"],
                     capabilities = [SpvCapabilitySignedZeroInfNanPreserve],
                     SpvExecutionModeSignedZeroInfNanPreserve, 32);

layout(local_size_x = 64) in;
layout(push_constant) uniform CONSTS { hk_agx3_refit_leaf_args args; };

#include "agx3_refit_leaf_body.h"
