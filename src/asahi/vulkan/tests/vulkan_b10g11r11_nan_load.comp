#version 450
// mode 0: texelFetch, mode 1: imageLoad; every texel's channel bits into a buffer
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, r11f_g11f_b10f) uniform readonly image2D img;
layout(set = 0, binding = 1) uniform sampler2D tex;
layout(set = 0, binding = 2) buffer Out { uvec4 v[]; } o;
layout(push_constant) uniform PC { uint w; uint h; uint mode; uint nanbits; } pc;
void main()
{
   uvec2 p = gl_GlobalInvocationID.xy;
   if (p.x >= pc.w || p.y >= pc.h)
      return;
   vec4 c = pc.mode == 0u ? texelFetch(tex, ivec2(p), 0) : imageLoad(img, ivec2(p));
   o.v[p.y * pc.w + p.x] = floatBitsToUint(c);
}
