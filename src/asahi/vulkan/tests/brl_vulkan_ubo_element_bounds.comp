#version 450
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std140, set = 0, binding = 0) uniform Ubo {
   uvec4 a[8194];
};

layout(std430, set = 0, binding = 1) readonly buffer Indices {
   uint count;
   uint idx[];
};

layout(std430, set = 0, binding = 2) writeonly buffer Out {
   uvec4 out_val[];
};

void main() {
   uint gid = gl_GlobalInvocationID.x;
   if (gid >= count)
      return;
   uint i = idx[gid];
   out_val[gid * 2u] = a[i];
   out_val[gid * 2u + 1u] = a[i + 1u];
}
